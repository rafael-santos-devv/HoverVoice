{
  "manifest_version": 3,
  "name": "HoverVoice",
  "version": "1.2.0",
  "description": "Acessibilidade para deficiência visual - Narrador ao passar o mouse, inclusive em PDFs",

  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "identity"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "HoverVoice - Leia o conteúdo ao passar o mouse",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },

  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },

  "background": {
    "service_worker": "src/background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared/state.js", "src/shared/i18n.js", "src/shared/voice.js", "src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "commands": {
    "toggle-extension": {
      "suggested_key": {
        "default": "Alt+A",
        "windows": "Alt+A",
        "mac": "Alt+A",
        "linux": "Alt+A"
      },
      "description": "Ativar/Desativar HoverVoice"
    },
    "open-pdf-viewer": {
      "suggested_key": {
        "default": "Alt+P",
        "windows": "Alt+P",
        "mac": "Alt+P",
        "linux": "Alt+P"
      },
      "description": "Abrir o PDF desta aba no leitor HoverVoice"
    }
  }
}
